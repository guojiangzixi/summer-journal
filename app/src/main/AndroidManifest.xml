<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ══════════ 网络 ══════════ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ══════════ 提醒（核心能力）══════════ -->
    <!-- Android 13+ 必须动态申请，见 PermissionManager -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+ 需跳系统页授权；未授权时 ReminderScheduler 自动降级 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 国内 ROM（含荣耀 MagicOS）必须申请，否则后台提醒可能不触发 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ══════════ 定位（仅用于天气，可拒绝）══════════ -->
    <!-- 只申请粗定位；精确定位由用户在设置里主动开启 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="35"
        tools:node="remove" />

    <!-- ══════════ 手札附件 ══════════ -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission
        android:name="android.permission.CAMERA"
        android:required="false" />

    <!-- Android 14+ 前台服务必须声明类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android 13+ 分项媒体权限：按需申请，不在启动时索要 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14+ 部分授权（用户只选几张图时用） -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Android 12 及以下的兼容路径 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".SummerJournalApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SummerJournal"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SummerJournal.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 教务系统登录用 WebView，独立 Activity 便于管理 Cookie 生命周期 -->
        <activity
            android:name=".data.remote.jwxt.JwxtLoginActivity"
            android:exported="false"
            android:label="@string/jwxt_login_title"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- ══════════ 提醒 ══════════ -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- 开机 / 应用升级 / 时区变化后重排所有提醒 -->
        <receiver
            android:name=".reminder.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ══════════ 手札录音前台服务 ══════════ -->
        <!-- 录音必须有前台服务 + 常驻通知，否则切后台就会被系统掐掉 -->
        <service
            android:name=".data.attachment.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 音频播放不单独起 Service：v1.0 用 Media3 在应用内播放即可。
             等要做「锁屏控制 / 后台连续播放」时再加 MediaSessionService。 -->

        <!-- ══════════ 附件分享 ══════════ -->
        <!-- 只暴露 attachments 目录，不要暴露整个 filesDir -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ══════════ WorkManager：按需初始化 ══════════
             我们要给 WorkManager 注入 HiltWorkerFactory（Worker 里才能 @Inject），
             所以走「按需初始化」这条官方路径：
               ① 在这里移除默认的 WorkManagerInitializer
               ② 在 SummerJournalApp.onCreate 里显式调用
                  WorkManager.initialize(this, workManagerConfiguration)

             ★ 两边只能做一次，不要「移除之后又指望默认初始化」。
               Lint 的 RemoveWorkManagerInitializer 检查就是在拦这个。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- 教务导入 WebView 需要独立进程隔离吗？不需要。
             但要在 Application 里开启 WebView 调试开关（仅 debug） -->
    </application>
</manifest>
