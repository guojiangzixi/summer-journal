# ══════════════════════════════════════════════════════════
#  夏日手札 · 签名配置模板
#
#  用法：
#    1. 先把本文件复制成 keystore.properties（去掉 .example）
#    2. 跑一次 generate-keystore.bat 生成 summer-journal.jks，
#       脚本会顺便帮你把密码填进来
#    3. ⚠️ keystore.properties 已经被 .gitignore 排除，**不要提交**
# ══════════════════════════════════════════════════════════

# keystore 文件位置，相对于项目根目录（code/）
storeFile=../summer-journal.jks

# keystore 密码
storePassword=在这里填你的密码

# 密钥别名，generate-keystore 脚本默认用 summerjournal
keyAlias=summerjournal

# 密钥密码（一般与 storePassword 相同）
keyPassword=在这里填你的密码
